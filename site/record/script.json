[
{
"id": "mn140:5.1",
"text": "“kaṁsi tvaṁ, bhikkhu, uddissa pabbajito? Ko vā te satthā? Kassa vā tvaṁ dhammaṁ rocesī”ti?"
},
{
"id": "an5.191:1.4",
"text": "Etarahi, bhikkhave, brāhmaṇā brāhmaṇimpi gacchanti, abrāhmaṇimpi gacchanti."
},
{
"id": "sn35.90:1.4",
"text": "cakkhuṁ na maññeyya, cakkhusmiṁ na maññeyya, cakkhuto na maññeyya, cakkhu meti na maññeyya;"
},
{
"id": "mn82:29.3",
"text": "Jarāpārijuññaṁ, byādhipārijuññaṁ, bhogapārijuññaṁ, ñātipārijuññaṁ."
},
{
"id": "an3.28:1.3",
"text": "Gūthabhāṇī, pupphabhāṇī, madhubhāṇī."
},
{
"id": "snp4.8:10.2",
"text": "Diṭṭhīhi diṭṭhiṁ avirujjhamānā;"
},
{
"id": "snp4.16:18.4",
"text": "Takkāsayaṁ kukkucciyūpachinde."
},
{
"id": "sn45.166:1.3",
"text": "Rāgo khilo, doso khilo, moho khilo—"
},
{
"id": "sn1.1:1.8",
"text": "yadāsvāhaṁ, āvuso, āyūhāmi tadāssu nibbuyhāmi."
},
{
"id": "dn18:17.7",
"text": "Sabbeva tuṇhībhūtā pañjalikā pallaṅkena nisīdanti:"
},
{
"id": "an5.229:1.3",
"text": "Asuci, duggandho, sabhīru, sappaṭibhayo, mittadubbhī."
},
{
"id": "dn16:2.16.7",
"text": "Atha kho te licchavī aṅguliṁ phoṭesuṁ:"
},
{
"id": "an5.75:1.4",
"text": "Evarūpopi, bhikkhave, idhekacco yodhājīvo hoti."
},
{
"id": "dn33:1.10.82",
"text": "jātithero, dhammathero, sammutithero."
},
{
"id": "an4.195:11.7",
"text": "Khaṇḍākhaṇḍikaṁ chetvā phāleyya."
},
{
"id": "an3.93:6.12",
"text": "Sīghaṁ sīghaṁ koṭṭāpetvā sīghaṁ sīghaṁ thusāni uddharāpeyya."
},
{
"id": "an3.70:2.9",
"text": "‘ahaṁ khvajja idañcidañca khādanīyaṁ khādiṁ, idañcidañca bhojanīyaṁ bhuñjiṁ;"
},
{
"id": "an6.56:1.3",
"text": "“āyasmā, bhante, phagguno ābādhiko dukkhito bāḷhagilāno."
},
{
"id": "mn115:4.6",
"text": "jivhādhātu, rasadhātu, jivhāviññāṇadhātu;"
},
{
"id": "dn33:1.11.164",
"text": "kāmogho, bhavogho, diṭṭhogho, avijjogho."
},
{
"id": "sn42.12:7.3",
"text": "Katamehi dvīhi ṭhānehi gārayho?"
},
{
"id": "mn84:4.2",
"text": "‘brāhmaṇova seṭṭho vaṇṇo, hīno añño vaṇṇo;"
},
{
"id": "sn48.22:1.3",
"text": "Itthindriyaṁ, purisindriyaṁ, jīvitindriyaṁ—"
},
{
"id": "dn26:20.2",
"text": "Sambhedaṁ loko gamissati yathā ajeḷakā kukkuṭasūkarā soṇasiṅgālā."
},
{
"id": "sn12.66:6.3",
"text": "Ye taṇhaṁ vaḍḍhesuṁ te upadhiṁ vaḍḍhesuṁ."
},
{
"id": "thag6.7:4.2",
"text": "Saṅghāṭikhuramuṇḍabhikkhabhojī;"
},
{
"id": "sn1.75:2.4",
"text": "Saddho mudū saṁvibhāgī vadaññū;"
},
{
"id": "snp4.2:1.1",
"text": "Satto guhāyaṁ bahunābhichanno,"
},
{
"id": "sn22.2:6.5",
"text": "Evaṁ puṭṭhā tumhe, āvuso, evaṁ byākareyyātha:"
},
{
"id": "an11.9:2.3",
"text": "Kathañca, khaḷuṅkajhāyitaṁ hoti?"
},
{
"id": "an7.63:13.1",
"text": "Yācīdha mātā bhaginī sakhīti ca,"
},
{
"id": "an3.70:2.3",
"text": "Gopālakuposatho, nigaṇṭhuposatho, ariyuposatho."
},
{
"id": "mn15:7.46",
"text": "‘kiṁ nu khomhi codito codakena codakassa paccāropemī’ti?"
},
{
"id": "sn47.7:1.4",
"text": "Tatra, bhikkhave, luddā makkaṭavīthīsu lepaṁ oḍḍenti makkaṭānaṁ bādhanāya."
},
{
"id": "sn9.5:2.4",
"text": "Kiṁ te biḷibiḷikā karissatī”ti."
},
{
"id": "sn19.10:2.2",
"text": "Piṇḍo sākuṇiyo nicchavorabbhi;"
},
{
"id": "mn118:15.4",
"text": "Satta bojjhaṅgā bhāvitā bahulīkatā vijjāvimuttiṁ paripūrenti."
},
{
"id": "an4.196:8.4",
"text": "mūle chinditvā agge chindeyya;"
},
{
"id": "dn2:45.17",
"text": "Tulākūṭakaṁsakūṭamānakūṭā paṭivirato hoti."
},
{
"id": "an10.99:3.4",
"text": "‘yannūnāhaṁ imaṁ udakarahadaṁ ogāhetvā kaṇṇasandhovikampi khiḍḍaṁ kīḷeyyaṁ piṭṭhisandhovikampi khiḍḍaṁ kīḷeyyaṁ."
},
{
"id": "mn82:42.34",
"text": "Dhīro ca na vedhati phassaphuṭṭho."
},
{
"id": "dn29:23.9",
"text": "Ayaṁ paṭhamo sukhallikānuyogo."
},
{
"id": "thag19.1:23.2",
"text": "Dīpīhi byagghehi purakkhato vasaṁ;"
},
{
"id": "mn50:16.3",
"text": "“etha, tumhe bhikkhū sīlavante kalyāṇadhamme sakkarotha garuṁ karotha mānetha pūjetha,"
},
{
"id": "dn1:1.11.2",
"text": "seyyathidaṁ—mūlabījaṁ khandhabījaṁ phaḷubījaṁ aggabījaṁ bījabījameva pañcamaṁ;"
},
{
"id": "sn35.229:4.4",
"text": "Amohayī maccurājanti brūmī”ti."
},
{
"id": "sn10.12:14.4",
"text": "Dve sukkā cīraāḷavīti dvādasa."
},
{
"id": "thag1.75:1.2",
"text": "Kaṅkhā chijjati buddhi vaḍḍhati;"
},
{
"id": "an4.196:11.1",
"text": "Seyyathāpi, sāḷha, yodhājīvo dūrepātī;"
},
{
"id": "snp5.4:1.6",
"text": "Yaññamakappayiṁsu puthūdha loke,"
},
{
"id": "dn30:2.6.7",
"text": "Balena vaṇṇena sukhena cūbhayaṁ;"
},
{
"id": "mn82:42.52",
"text": "Daharā ca vuḍḍhā ca sarīrabhedā;"
},
{
"id": "dn19:46.17",
"text": "Icchā vivicchā paraheṭhanā ca,"
},
{
"id": "thag19.1:51.2",
"text": "Nāgaṁva thambhamhi daḷhāya rajjuyā;"
},
{
"id": "sn7.14:1.4",
"text": "“kiṁ nu tvaṁ, brāhmaṇa, lūkho lūkhapāvuraṇo”ti?"
},
{
"id": "mn116:6.3",
"text": "Paccekabuddhā bhavanettikhīṇā,"
},
{
"id": "an4.144:1.3",
"text": "Candobhāso, sūriyobhāso, aggobhāso, paññobhāso—"
},
{
"id": "sn22.136:1.2",
"text": "“Rūpaṁ, bhikkhave, kukkuḷaṁ, vedanā kukkuḷā, saññā kukkuḷā, saṅkhārā kukkuḷā, viññāṇaṁ kukkuḷaṁ."
},
{
"id": "mn129:15.2",
"text": "So tattha pheṇuddehakaṁ paccati."
},
{
"id": "sn29.21-50:3.2",
"text": "Evaṁ catūsu yonīsu cattālīsaṁ veyyākaraṇā honti."
},
{
"id": "sn6.6:5.2",
"text": "Byagghīnisā pañcasatā ca jhāyino;"
},
{
"id": "dn25:7.16",
"text": "Iṅgha tvaṁ maṁ, nigrodha, sake ācariyake adhijegucche pañhaṁ puccha:"
},
{
"id": "sn22.79:14.20",
"text": "Kiñca neva vidhūpeti na sandhūpeti, vidhūpetvā ṭhito?"
},
{
"id": "dhp271:0",
"text": "Sambahulasīlādisampannabhikkhuvatthu"
},
{
"id": "dn21:1.12.58",
"text": "Kāmābhibhū sakyamunīti ñāyati;"
},
{
"id": "dn30:2.6.3",
"text": "Cāgena dhammena bahūhi sādhuhi;"
},
{
"id": "sn35.90:1.1",
"text": "“Ejā, bhikkhave, rogo, ejā gaṇḍo, ejā sallaṁ."
},
{
"id": "mn104:17.6",
"text": "Tamenaṁ so nibbeṭhentaṁ ativeṭheti:"
},
{
"id": "dn30:2.9.2",
"text": "“Na pāṇidaṇḍehi panātha leḍḍunā,"
},
{
"id": "an8.6:6.5",
"text": "uppannaṁ sukhaṁ nānurujjhati, dukkhe nappaṭivirujjhati."
},
{
"id": "an4.195:11.6",
"text": "So taṁ thūṇaṁ khaṇḍākhaṇḍikaṁ chindeyya."
},
{
"id": "snp2.12:6.1",
"text": "Ye keci ganthā idha mohamaggā,"
},
{
"id": "sn4.25:16.1",
"text": "“Kathaṁvihārībahulodha bhikkhu,"
},
{
"id": "mn31:22.16",
"text": "Cūḷagosiṅgasuttaṁ niṭṭhitaṁ paṭhamaṁ."
},
{
"id": "an2.35:3.1",
"text": "“Sekho asekho ca imasmiṁ loke,"
},
{
"id": "mn36:46.4",
"text": "Api ca, aggivessana, yathā sammūḷho ca hoti asammūḷho ca,"
},
{
"id": "sn14.16:4.3",
"text": "kheḷo kheḷena saṁsandati sameti;"
},
{
"id": "thag19.1:44.3",
"text": "Na jātu bhastaṁ ubhatomukhaṁ chupe,"
},
{
"id": "sn35.232:10.10",
"text": "Ghāyati bhagavā ghānena gandhaṁ."
},
{
"id": "thag2.16:1.1",
"text": "“Kāḷī itthī brahatī dhaṅkarūpā,"
},
{
"id": "ud5.6:10.3",
"text": "‘so bhagavā īdiso ca īdiso cā’ti."
},
{
"id": "sn17.5:1.5",
"text": "‘ahamhi gūthādī gūthapūrā puṇṇā gūthassa, purato ca myāyaṁ mahāgūthapuñjo’ti."
},
{
"id": "dn31:10.2",
"text": "Kva naccaṁ, kva gītaṁ, kva vāditaṁ, kva akkhānaṁ, kva pāṇissaraṁ, kva kumbhathunanti."
},
{
"id": "dn33:1.10.109",
"text": "sutāvudhaṁ, pavivekāvudhaṁ, paññāvudhaṁ."
},
{
"id": "dn20:3.14",
"text": "“Chetvā khīlaṁ chetvā palighaṁ,"
},
{
"id": "an9.3:19.3",
"text": "Aniccasaññino, meghiya, anattasaññā saṇṭhāti."
},
{
"id": "snp3.5:5.5",
"text": "Ārādhaye dakkhiṇeyyebhi tādi”."
},
{
"id": "dn24:1.22.5",
"text": "‘parābhūtarūpo, bho, acelo pāthikaputto."
},
{
"id": "sn35.247:5.8",
"text": "Daḷhāya rajjuyā bandhitvā daḷhe khīle vā thambhe vā upanibandheyya."
},
{
"id": "sn42.7:2.4",
"text": "Ete hi, gāmaṇi, maṁdīpā maṁleṇā maṁtāṇā maṁsaraṇā viharanti."
},
{
"id": "mn139:13.31",
"text": "Tatra, bhikkhave, yvāyaṁ rahovādo bhūto taccho anatthasaṁhito, sadukkho eso dhammo saupaghāto saupāyāso sapariḷāho;"
},
{
"id": "thag16.4:15.4",
"text": "Dhīro ca no vedhati phassaphuṭṭho."
},
{
"id": "an5.55:4.3",
"text": "Te dīgharattaṁ socanti itthiphoṭṭhabbavasānugā."
},
{
"id": "sn35.94:7.3",
"text": "Sāduṁ rasaṁ nājjhosāya bhuñje,"
},
{
"id": "thag16.8:4.2",
"text": "Sobbhe papāte narake anvakāsi;"
},
{
"id": "mn28:9.2",
"text": "pāṇisamphassenapi leḍḍusamphassenapi daṇḍasamphassenapi satthasamphassenapi."
},
{
"id": "sn22.60:5.3",
"text": "sārāgā saṁyujjanti; saṁyogā saṅkilissanti."
},
{
"id": "an10.117:1.12",
"text": "micchāñāṇaṁ orimaṁ tīraṁ, sammāñāṇaṁ pārimaṁ tīraṁ;"
},
{
"id": "snp3.11:11.1",
"text": "Disvā jaṭī kaṇhasirivhayo isi,"
},
{
"id": "snp3.5:21.2",
"text": "Sambodhipatto saraṇaṁ bahūnaṁ;"
},
{
"id": "sn12.51:9.3",
"text": "Āneñjañce saṅkhāraṁ abhisaṅkharoti āneñjūpagaṁ hoti viññāṇaṁ."
},
{
"id": "dhp46:0",
"text": "Marīcikammaṭṭhānikabhikkhuvatthu"
},
{
"id": "an11.9:2.1",
"text": "“Ājānīyajhāyitaṁ kho, saddha, jhāya;"
},
{
"id": "thag19.1:47.2",
"text": "Sampupphite meghanibhamhi kānane;"
},
{
"id": "dn19:36.2",
"text": "Tatra sudaṁ majjhe reṇussa rañño janapado hoti."
},
{
"id": "thag1.72:1.1",
"text": "“Yathā kaḷīro susu vaḍḍhitaggo,"
},
{
"id": "an3.62:1.4",
"text": "Mahāaggiḍāhe kho pana, bhikkhave, vuṭṭhite tena gāmāpi ḍayhanti nigamāpi ḍayhanti nagarāpi ḍayhanti."
},
{
"id": "mn12:52.5",
"text": "Te kolampi khādanti, kolacuṇṇampi khādanti, kolodakampi pivanti—"
},
{
"id": "snp1.3:27.1",
"text": "“Saṅgo eso parittamettha sokhyaṁ,"
},
{
"id": "snp4.11:13.1",
"text": "“Na saññasaññī na visaññasaññī,"
},
{
"id": "thag19.1:16.1",
"text": "Kadā iṇaṭṭova daliddako nidhiṁ,"
},
{
"id": "an6.52:5.1",
"text": "“Itthī pana, bho gotama, kiṁadhippāyā, kiṁupavicārā, kiṁadhiṭṭhānā, kiṁabhinivesā, kiṁpariyosānā”ti?"
},
{
"id": "an3.65:21.1",
"text": "“Viññugarahitā vā viññuppasatthā vā”ti?"
},
{
"id": "mn20:9.2",
"text": "Mahācūḷadukkhakkhandhaanumānikasuttaṁ;"
},
{
"id": "an10.117:1.8",
"text": "micchāājīvo orimaṁ tīraṁ, sammāājīvo pārimaṁ tīraṁ;"
},
{
"id": "sn16.10:4.4",
"text": "udāhu ahaṁ sūcikāro, tvaṁ sūcivāṇijako”ti?"
},
{
"id": "sn4.13:4.3",
"text": "Tepīdha soppaṁ labhare sasallā,"
},
{
"id": "sn6.13:2.4",
"text": "Saṅghe vase rakkhitatto satīmā."
},
{
"id": "an10.72:7.3",
"text": "Akaṇṭakanikkaṇṭakā, bhikkhave, viharatha."
},
{
"id": "dn5:21.3",
"text": "Kūṭadanto pana brāhmaṇo tūṇhībhūtova nisinno hoti."
},
{
"id": "sn22.101:6.4",
"text": "Atha khvassa khīṇe khīṇantveva ñāṇaṁ hoti."
},
{
"id": "dn21:1.12.67",
"text": "Nitiṇṇaoghaṁ vicikicchachinnaṁ,"
},
{
"id": "sn3.24:1.10",
"text": "idha tyassa yuddhaṁ paccupaṭṭhitaṁ saṅgāmo samupabyūḷho."
},
{
"id": "mn25:6.40",
"text": "Yannūna mayaṁ catutthe migajāte ajjhupekkheyyāmā’ti."
},
{
"id": "sn42.6:5.3",
"text": "‘ummujja, bho puthusile, uplava, bho puthusile, thalamuplava, bho puthusile’ti."
},
{
"id": "sn7.9:14.3",
"text": "Jivhā sujā hadayaṁ jotiṭhānaṁ,"
},
{
"id": "snp1.3:38.1",
"text": "“Sīho yathā dāṭhabalī pasayha,"
},
{
"id": "an3.128:4.5",
"text": "“kiṁ nu kho, bhante, kaṭuviyaṁ?"
},
{
"id": "dn30:2.31.7",
"text": "Karitvā nipuṇebhi vidūhi sabbhi;"
},
{
"id": "an10.99:5.3",
"text": "nanvāyaṁ kevalā paripūrā bālakhiḍḍā”ti?"
},
{
"id": "mn3:3.3",
"text": "Atha dve bhikkhū āgaccheyyuṁ jighacchādubbalyaparetā."
},
{
"id": "sn22.106:1.16",
"text": "Yvāyaṁ āyasmā evaṁnāmo evaṅgotto—"
},
{
"id": "an8.11:12.2",
"text": "Ahañhi, brāhmaṇa, jeṭṭho seṭṭho lokassa."
},
{
"id": "mn67:14.4",
"text": "Ūmibhayaṁ, kumbhīlabhayaṁ, āvaṭṭabhayaṁ, susukābhayaṁ—"
},
{
"id": "sn42.8:1.6",
"text": "Yaṁbahulaṁ yaṁbahulaṁ viharati, tena tena nīyatī’ti."
},
{
"id": "sn46.44:1.2",
"text": "“‘duppañño eḷamūgo, duppañño eḷamūgo’ti, bhante, vuccati."
},
{
"id": "dn33:1.10.33",
"text": "hīnadhātu, majjhimadhātu, paṇītadhātu."
},
{
"id": "an7.68:4.8",
"text": "Iti dhammaññū, atthaññū, attaññū."
},
{
"id": "snp1.3:30.2",
"text": "Sañchannapatto yathā pārichatto;"
},
{
"id": "mn37:14.7",
"text": "yassa te sabrahmacārī evaṁmahiddhiko evaṁmahānubhāvo."
},
{
"id": "mn70:27.11",
"text": "Kīṭāgirisuttaṁ niṭṭhitaṁ dasamaṁ."
},
{
"id": "sn17.5:1.4",
"text": "Sā tena aññā mīḷhakā atimaññeyya:"
},
{
"id": "snp3.11:5.3",
"text": "Sakyāna gāme janapade lumbineyye,"
},
{
"id": "dn16:5.3.2",
"text": "“sabbaphāliphullā kho, ānanda, yamakasālā akālapupphehi."
},
{
"id": "dn33:1.10.127",
"text": "kāyamoneyyaṁ, vacīmoneyyaṁ, manomoneyyaṁ."
},
{
"id": "snp4.9:2.4",
"text": "Bhavūpapattiñca vadesi kīdisaṁ”."
},
{
"id": "sn48.43:4.6",
"text": "yaṁ paññindriyaṁ taṁ paññābalaṁ, yaṁ paññābalaṁ taṁ paññindriyaṁ."
},
{
"id": "mn22:33.1",
"text": "Kathañca, bhikkhave, bhikkhu abbūḷhesiko hoti?"
},
{
"id": "snp1.3:2.2",
"text": "Snehanvayaṁ dukkhamidaṁ pahoti;"
},
{
"id": "thag10.1:3.3",
"text": "Passantu taṁ sākiyā koḷiyā ca,"
},
{
"id": "an3.140:1.1",
"text": "“Tayo ca, bhikkhave, assakhaḷuṅke desessāmi tayo ca purisakhaḷuṅke."
},
{
"id": "sn5.6:1.6",
"text": "“Jātiṁ khvāhaṁ, āvuso, na rocemī”ti."
},
{
"id": "snp3.11:4.2",
"text": "Bhujāni phoṭenti ca naccayanti ca;"
},
{
"id": "mn82:30.4",
"text": "‘ahaṁ khomhi etarahi jiṇṇo vuḍḍho mahallako addhagato vayoanuppatto."
},
{
"id": "mn90:16.5",
"text": "“Viṭaṭūbho, mahārāja, senāpatī”ti."
},
{
"id": "an5.45:7.2",
"text": "Bahubheravaṁ ratnagaṇānamālayaṁ;"
},
{
"id": "dn29:1.6",
"text": "Vadhoyeva kho maññe nigaṇṭhesu nāṭaputtiyesu vattati."
},
{
"id": "dn22:7.3",
"text": "‘ayampi kho kāyo evaṁdhammo evaṁbhāvī evaṁanatīto’ti."
},
{
"id": "an10.79:1.1",
"text": "“Dasayimāni, bhikkhave, āghātavatthūni."
},
{
"id": "dn26:19.4",
"text": "sappi navanītaṁ telaṁ madhu phāṇitaṁ loṇaṁ."
},
{
"id": "an5.195:3.1",
"text": "“Padmaṁ yathā kokanadaṁ sugandhaṁ,"
},
{
"id": "snp1.10:6.4",
"text": "Kathaṁjīviṁ jīvitamāhu seṭṭhaṁ”."
},
{
"id": "snp5.8:1.4",
"text": "Ñāṇūpapannaṁ no muniṁ vadanti,"
},
{
"id": "sn35.229:3.4",
"text": "Saūmibhayaṁ duttaraṁ accatari."
},
{
"id": "sn45.160:1.13",
"text": "kiṁ muṇḍo kapālamanusaṁcarasi."
},
{
"id": "sn35.246:3.5",
"text": "Daṇḍena sutāḷitaṁ tāḷetvā osajjeyya."
},
{
"id": "dn23:5.2",
"text": "“ahañhi, bho kassapa, evaṁvādī evaṁdiṭṭhī:"
},
{
"id": "an3.34:5.3",
"text": "Evassu tāni, bhikkhave, bījāni vuddhiṁ viruḷhiṁ vepullaṁ āpajjeyyuṁ."
},
{
"id": "an8.51:18.1",
"text": "Ajjatagge ovaṭo bhikkhunīnaṁ bhikkhūsu vacanapatho, anovaṭo bhikkhūnaṁ bhikkhunīsu vacanapatho."
},
{
"id": "sn4.25:14.3",
"text": "Ekohaṁ jhāyaṁ sukhamanubodhiṁ,"
},
{
"id": "an3.66:23.1",
"text": "“Iti kho, sāḷhā, yaṁ taṁ avocumhā:"
},
{
"id": "thag19.1:23.1",
"text": "‘Mayūrakoñcābhirutamhi kānane,"
},
{
"id": "snp2.2:14.2",
"text": "Nirāmagandhaṁ sabbadukkhappanūdanaṁ;"
},
{
"id": "dn33:1.10.131",
"text": "ārogyamado, yobbanamado, jīvitamado."
},
{
"id": "an3.48:1.3",
"text": "Sākhāpattapalāsena vaḍḍhanti, tacapapaṭikāya vaḍḍhanti, pheggusārena vaḍḍhanti."
},
{
"id": "sn35.245:8.6",
"text": "‘eso, bhante, majjhe siṅghāṭake nisinno’ti."
},
{
"id": "mn63:10.8",
"text": "Cūḷamālukyasuttaṁ niṭṭhitaṁ tatiyaṁ."
},
{
"id": "an7.63:10.1",
"text": "Yācīdha disvāna patiṁ pamodati,"
},
{
"id": "sn1.25:4.2",
"text": "Vidhūpitā mānaganthassa sabbe;"
},
{
"id": "dn31:24.1",
"text": "Catūhi kho, gahapatiputta, ṭhānehi atthakkhāyī mitto suhado veditabbo."
},
{
"id": "an4.196:4.6",
"text": "sākhāpalāsaṁ suvisodhitaṁ visodhetvā kuṭhārīhi taccheyya;"
},
{
"id": "mn77:6.60",
"text": "Tamenāññataro sabrahmacārī jaṇṇukena ghaṭṭesi:"
},
{
"id": "sn22.31:1.2",
"text": "“Aghañca, bhikkhave, desessāmi aghamūlañca."
},
{
"id": "an4.159:4.8",
"text": "Methune ca setughāto vutto bhagavatā."
},
{
"id": "mn12:44.2",
"text": "tapassī sudaṁ homi paramatapassī, lūkho sudaṁ homi paramalūkho, jegucchī sudaṁ homi paramajegucchī, pavivitto sudaṁ homi paramapavivitto."
},
{
"id": "sn9.14:11.3",
"text": "Majjhanhikālamhi pākatindriya—"
},
{
"id": "an9.14:10.1",
"text": "“Te pana, samiddhi, kiṁogadhā”ti?"
},
{
"id": "snp2.1:13.1",
"text": "Vanappagumbe yatha phussitagge,"
},
{
"id": "snp4.12:14.3",
"text": "Evampi titthyā puthuso vadanti,"
},
{
"id": "dn24:1.21.12",
"text": "‘kiṁ su nāma te, āvuso pāthikaputta, pāvaḷā su nāma te pīṭhakasmiṁ allīnā, pīṭhakaṁ su nāma te pāvaḷāsu allīnaṁ?"
},
{
"id": "sn55.41:5.3",
"text": "Atha kho asaṅkhyeyyo appameyyo mahāudakakkhandhotveva saṅkhyaṁ gacchati."
},
{
"id": "sn47.6:2.2",
"text": "‘ehi kho dāni me, sakuṇagghi, ehi kho dāni me, sakuṇagghī’ti."
},
{
"id": "an7.63:7.2",
"text": "Pharusā ca caṇḍī duruttavādinī;"
},
{
"id": "snp2.2:7.2",
"text": "Māyā usūyā bhassasamussayo ca;"
},
{
"id": "thag19.1:48.4",
"text": "Biḷārabhastaṁva yathā sumadditaṁ."
},
{
"id": "thig13.4:16.2",
"text": "Phītañcimaṁ gahavibhavaṁ pahāya;"
},
{
"id": "mn16:26.4",
"text": "vīmaṁsāsamādhipadhānasaṅkhārasamannāgataṁ iddhipādaṁ bhāveti, ussoḷhīyeva pañcamī."
},
{
"id": "snp4.5:6.1",
"text": "Yassūbhayante paṇidhīdha natthi,"
},
{
"id": "an4.62:5.1",
"text": "Katamañca, gahapati, ānaṇyasukhaṁ?"
},
{
"id": "dn1:1.31.4",
"text": "‘sassato attā ca loko ca vañjho kūṭaṭṭho esikaṭṭhāyiṭṭhito;"
},
{
"id": "sn35.232:4.5",
"text": "“Na kho, āvuso, kāḷo balībaddo odātassa balībaddassa saṁyojanaṁ, na odāto balībaddo kāḷassa balībaddassa saṁyojanaṁ."
},
{
"id": "thag2.46:1.1",
"text": "“Nadanti morā susikhā supekhuṇā,"
},
{
"id": "mn46:2.1",
"text": "“yebhuyyena, bhikkhave, sattā evaṅkāmā evaṁchandā evaṁadhippāyā:"
},
{
"id": "an4.196:12.1",
"text": "Seyyathāpi, sāḷha, yodhājīvo akkhaṇavedhī;"
},
{
"id": "mn108:24.3",
"text": "mānetabbaṁ mānenti, pūjetabbaṁ pūjenti”?"
},
{
"id": "dn5:18.5",
"text": "Sappitelanavanītadadhimadhuphāṇitena ceva so yañño niṭṭhānamagamāsi."
},
{
"id": "sn12.51:3.3",
"text": "idaṁ nu kho dukkhaṁ kiṁnidānaṁ kiṁsamudayaṁ kiṁjātikaṁ kiṁpabhavaṁ?"
},
{
"id": "sn55.39:3.2",
"text": "Ahañhi, bhante, buddhe aveccappasādena samannāgatā—"
},
{
"id": "an9.40:6.7",
"text": "So attamano soṇḍaṁ saṁharatī”ti."
},
{
"id": "dhp338:1",
"text": "Yathāpi mūle anupaddave daḷhe,"
},
{
"id": "sn12.66:7.3",
"text": "Ye taṇhaṁ vaḍḍhissanti te upadhiṁ vaḍḍhissanti."
},
{
"id": "an2.128:1.3",
"text": "Duṭṭhullā ca āpatti, aduṭṭhullā ca āpatti."
},
{
"id": "ud4.1:21.3",
"text": "Aniccasaññino hi, meghiya, anattasaññā saṇṭhāti,"
},
{
"id": "sn47.6:2.4",
"text": "Yadā kho, bhikkhave, aññāsi lāpo sakuṇo ‘bahuāgato kho myāyaṁ sakuṇagghī’ti, atha tasseva leḍḍussa antaraṁ paccupādi."
},
{
"id": "sn16.11:14.6",
"text": "‘mudukā kho tyāyaṁ, kassapa, paṭapilotikānaṁ saṅghāṭī’ti."
},
{
"id": "mn67:16.1",
"text": "Katamañca, bhikkhave, ūmibhayaṁ?"
},
{
"id": "sn17.3:1.7",
"text": "Tamenaṁ luddo papatāya vijjhi."
},
{
"id": "sn7.11:10.2",
"text": "Khīṇāsavaṁ kukkuccavūpasantaṁ;"
},
{
"id": "snp3.11:14.1",
"text": "Disvāna sakye isimavoca akalye,"
},
{
"id": "an2.152:1.1",
"text": "“Dveme, bhikkhave, paṭisanthārā."
},
{
"id": "mn91:24.2",
"text": "Tatra sudaṁ bhagavā mithilāyaṁ viharati maghadevaambavane."
},
{
"id": "mn7:4.18",
"text": "‘sāṭheyyaṁ cittassa upakkileso’ti—"
},
{
"id": "sn5.5:2.1",
"text": "“Supupphitaggaṁ upagamma bhikkhuni,"
},
{
"id": "mn93:18.29",
"text": "‘Na bhavantānaṁ moghaṁ tapo, nāphalaṁ brahmacariyaṁ."
},
{
"id": "ud6.4:26.2",
"text": "‘ediso, deva, hatthī seyyathāpi thūṇo’ti."
},
{
"id": "dn23:25.6",
"text": "‘ayaṁ kho pahūto sukkhagūtho chaḍḍito, mama ca sūkarabhattaṁ;"
},
{
"id": "sn8.2:4.2",
"text": "Diṭṭhasute paṭighe ca mute ca;"
},
{
"id": "an7.57:10.8",
"text": "‘sīho senāpati dāyako kārako saṅghupaṭṭhāko’ti."
},
{
"id": "sn48.53:6.4",
"text": "Yaṅgatikāni yaṁparamāni yaṁphalāni yaṁpariyosānāni. Kāyena ca phusitvā viharati;"
},
{
"id": "sn22.62:13.4",
"text": "Nindāghaṭṭanabyārosaupārambhabhayā”ti."
},
{
"id": "an3.39:6.3",
"text": "Yobbanamado, ārogyamado, jīvitamado."
},
{
"id": "sn16.3:5.2",
"text": "kathaṁrūpassa bhikkhuno aparisuddhā dhammadesanā hoti, kathaṁrūpassa bhikkhuno parisuddhā dhammadesanā hotī”ti?"
},
{
"id": "dn31:13.1",
"text": "Cha khome, gahapatiputta, ādīnavā ālasyānuyoge."
},
{
"id": "snp1.5:5.3",
"text": "Taṁ kaṅkhachidaṁ muniṁ anejaṁ,"
},
{
"id": "dn30:2.3.14",
"text": "Idha ca mahīpatissa kāmabhogī,"
},
{
"id": "sn42.13:23.3",
"text": "‘yvāyaṁ satthā evaṁvādī evaṁdiṭṭhi:"
},
{
"id": "mn84:5.1",
"text": "“Ghosoyeva kho eso, mahārāja, lokasmiṁ:"
},
{
"id": "sn56.45:3.3",
"text": "yo dūratova sukhumena tāḷacchiggaḷena asanaṁ atipāteyya poṅkhānupoṅkhaṁ avirādhitaṁ, yo vā sattadhā bhinnassa vālassa koṭiyā koṭiṁ paṭivijjheyyā”ti?"
},
{
"id": "sn56.70:1.3",
"text": "Paṭhamaāmakadhaññapeyyālavaggo sattamo."
},
{
"id": "dn34:1.6.13",
"text": "pītipharaṇatā, sukhapharaṇatā, cetopharaṇatā, ālokapharaṇatā, paccavekkhaṇanimittaṁ."
},
{
"id": "sn14.12:9.3",
"text": "avihiṁsāsaṅkappaṁ paṭicca uppajjati avihiṁsāchando,"
},
{
"id": "ud2.10:5.1",
"text": "“Evaṁ, bhante”ti kho so bhikkhu bhagavato paṭissutvā yenāyasmā bhaddiyo kāḷīgodhāya putto tenupasaṅkami; upasaṅkamitvā bhaddiyaṁ kāḷīgodhāya puttaṁ etadavoca:"
},
{
"id": "mn86:6.3",
"text": "Mamañca brūsi ṭhitamaṭṭhitoti;"
},
{
"id": "sn2.13:2.1",
"text": "“Bhikkhu siyā jhāyī vimuttacitto,"
},
{
"id": "iti46:3.2",
"text": "Paññuttaraṁ jātikhayantadassiṁ;"
},
{
"id": "sn12.66:6.4",
"text": "Ye upadhiṁ vaḍḍhesuṁ te dukkhaṁ vaḍḍhesuṁ."
},
{
"id": "mn22:33.3",
"text": "Evaṁ kho, bhikkhave, bhikkhu abbūḷhesiko hoti."
},
{
"id": "an4.103:4.5",
"text": "Seyyathāpi so, bhikkhave, kumbho tuccho vivaṭo;"
},
{
"id": "an2.48:2.1",
"text": "Katamā ca, bhikkhave, saddhammagaru parisā noāmisagaru?"
},
{
"id": "mn82:30.2",
"text": "Idha, bho raṭṭhapāla, ekacco jiṇṇo hoti vuḍḍho mahallako addhagato vayoanuppatto."
},
{
"id": "an3.101:3.2",
"text": "tatra tatreva sakkhibhabbataṁ pāpuṇāti sati satiāyatane."
},
{
"id": "sn42.13:3.2",
"text": "jānāsi tvaṁ koliyānaṁ lambacūḷake bhaṭe”ti?"
},
{
"id": "an5.58:4.4",
"text": "Yānipi tāni kulesu paheṇakāni pahīyanti, ucchūti vā badarāti vā pūvāti vā modakāti vā saṅkulikāti vā, tāni vilumpitvā vilumpitvā khādanti;"
},
{
"id": "thag21.1:56.3",
"text": "So taṁ namassaṁ acari mutyapekho,"
},
{
"id": "sn10.3:1.1",
"text": "Ekaṁ samayaṁ bhagavā gayāyaṁ viharati ṭaṅkitamañce sūcilomassa yakkhassa bhavane."
},
{
"id": "dn25:22.18",
"text": "Tiṭṭhatu, nigrodha, ekaṁ vassaṁ."
},
{
"id": "an3.128:5.1",
"text": "“Abhijjhā kho, bhikkhu, kaṭuviyaṁ;"
},
{
"id": "an5.205:1.1",
"text": "“Pañcime, bhikkhave, cetokhilā."
},
{
"id": "mn12:45.11",
"text": "kaṇṭakāpassayikopi homi kaṇṭakāpassaye seyyaṁ kappemi;"
},
{
"id": "dn23:25.9",
"text": "Tassa antarāmagge mahāakālamegho pāvassi."
},
{
"id": "mn87:26.2",
"text": "“Evaṁ, mallike, piyo me viṭaṭūbho senāpatī”ti."
},
{
"id": "mn21:11.5",
"text": "atthasaṁhitena vā anatthasaṁhitena vā;"
},
{
"id": "mn101:7.14",
"text": "“ahaṁ kho pubbe sallena viddho ahosiṁ savisena gāḷhūpalepanena."
},
{
"id": "mn105:17.1",
"text": "Seyyathāpi, sunakkhatta, tālo matthakacchinno abhabbo puna viruḷhiyā;"
},
{
"id": "an5.161:1.9",
"text": "Yasmiṁ, bhikkhave, puggale āghāto jāyetha, asatiamanasikāro tasmiṁ puggale āpajjitabbo;"
},
{
"id": "mn5:30.10",
"text": "suhitānampi bhottukamyatā assa, pageva jighacchitānaṁ."
},
{
"id": "mn116:6.8",
"text": "Sacco tatho virajo paṇḍito ca."
},
{
"id": "mn82:42.31",
"text": "Aḍḍhā daliddā ca phusanti phassaṁ,"
},
{
"id": "sn1.73:1.1",
"text": "“Kiṁsūdha vittaṁ purisassa seṭṭhaṁ,"
},
{
"id": "an9.14:8.1",
"text": "“Te pana, samiddhi, kiṁuttarā”ti?"
},
{
"id": "snp1.3:2.1",
"text": "“Saṁsaggajātassa bhavanti snehā,"
},
{
"id": "snp1.3:10.2",
"text": "Sañchinnapatto yathā koviḷāro;"
},
{
"id": "snp1.5:3.3",
"text": "Maggakkhāyī kathaṁ atulyo hoti;"
},
{
"id": "snp2.1:11.2",
"text": "Chaccābhiṭhānāni abhabba kātuṁ;"
},
{
"id": "snp4.12:15.3",
"text": "Evampi titthyā puthuso niviṭṭhā,"
},
{
"id": "snp5.19:29.3",
"text": "Soḷasabrāhmaṇānaṁ kira puṭṭho,"
},
{
"id": "thig15.1:20.1",
"text": "Te maṁ pitugharaṁ paṭinayiṁsu,"
},
{
"id": "thig16.1:22.2",
"text": "Parabhattaṁ nhāyanti jigucchantā;"
},
{
"id": "mn5:4.2",
"text": "so sarāgo sadoso samoho sāṅgaṇo saṅkiliṭṭhacitto kālaṁ karissati."
},
{
"id": "an10.152:1.1",
"text": "“Bahulīkātabbañca vo, bhikkhave, dhammaṁ desessāmi na bahulīkātabbañca."
},
{
"id": "an2.47:2.1",
"text": "Katamā ca, bhikkhave, paṭipucchāvinītā parisā nookkācitavinītā?"
},
{
"id": "dn23:22.3",
"text": "‘pāyāsi rājañño evaṁvādī evaṁdiṭṭhī:"
},
{
"id": "sn19.9:1.6",
"text": "ūrūsu pavisitvā jaṅghāhi nikkhamanti;"
},
{
"id": "an4.202:5.7",
"text": "attanā ca upaṭṭhitassati hoti, parañca satiupaṭṭhāne samādapeti;"
},
{
"id": "mn54:16.1",
"text": "Seyyathāpi, gahapati, gijjho vā kaṅko vā kulalo vā maṁsapesiṁ ādāya uḍḍīyeyya."
},
{
"id": "dn4:3.10",
"text": "‘soṇadaṇḍo, bho, brāhmaṇo evamāha—"
},
{
"id": "mn117:38.3",
"text": "Nindābyārosaupārambhabhayā”ti."
},
{
"id": "iti69:3.4",
"text": "Saūmibhayaṁ duttaraṁ accatāri."
},
{
"id": "thag19.1:19.3",
"text": "Sabbaṁ pahāya imamajjhupāgato,"
},
{
"id": "thag9.1:7.1",
"text": "Yadā nisīthe rahitamhi kānane,"
},
{
"id": "mn102:11.4",
"text": "‘iti pecca bhavissāma, iti pecca bhavissāmā’ti."
},
{
"id": "an3.48:1.1",
"text": "“Himavantaṁ, bhikkhave, pabbatarājaṁ nissāya mahāsālā tīhi vaḍḍhīhi vaḍḍhanti."
},
{
"id": "an9.37:3.3",
"text": "“Saññīmeva kho, āvuso, tadāyatanaṁ no paṭisaṁvedeti, no asaññī”ti."
},
{
"id": "mn135:7.5",
"text": "sattānaṁ viheṭhakajātiko hoti pāṇinā vā leḍḍunā vā daṇḍena vā satthena vā."
},
{
"id": "mn22:36.1",
"text": "Evaṁ vimuttacittaṁ kho, bhikkhave, bhikkhuṁ saindā devā sabrahmakā sapajāpatikā anvesaṁ nādhigacchanti:"
},
{
"id": "sn21.1:2.3",
"text": "‘ariyo tuṇhībhāvo, ariyo tuṇhībhāvoti vuccati."
},
{
"id": "an4.196:4.7",
"text": "kuṭhārīhi tacchetvā vāsīhi taccheyya;"
},
{
"id": "mn90:9.8",
"text": "yadidaṁ abhivādanapaccuṭṭhānaañjalikammasāmīcikammānī”ti."
},
{
"id": "sn22.62:13.5",
"text": "Majjhimapaṇṇāsakassa upayavaggo paṭhamo."
