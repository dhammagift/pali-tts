[Unit]
Description=ru-accent: Russian stress marks (ruaccent) for the Pali TTS service's Russian voices, localhost:3016
After=network.target

[Service]
WorkingDirectory=/var/www/pali-tts
ExecStart=/var/www/pali-tts/.venv-acc/bin/python ru_accent_server.py --port 3016
Restart=on-failure
# Shares the box with production, like pali-tts
Nice=10
CPUQuota=100%
MemoryMax=1200M

[Install]
WantedBy=multi-user.target
