+// Pali (pi): romanised Pali (IAST, as in the Mahāsaṅgīti / SuttaCentral editions).
+// Pali spelling is phonemic, so these rules are letter -> sound, left to right, every vowel sounded.
+// Phonemes from the Hindi table (hi_base): V a: I i: U u: e: e o: o, aspirates with #,
+// retroflexes with a dot (t. d. n. l.), n^ = ñ, N = ṅ.
+
+.L01 k g c j ṭ ḍ t d p b ṅ ñ ṇ n m y r l ḷ v s h   // consonant letters
+.L02 k g c j ṭ ḍ t d p b   // stops that have an aspirate (kh ... bh: one consonant)
+
+.group a
+       a        V
+
+.group ā
+       ā        a:
+
+.group i
+       i        I
+
+.group ī
+       ī        i:
+
+.group u
+       u        U
+
+.group ū
+       ū        u:
+
+.group e
+       e        e:
+       e (L01L01  e        // short before two consonants: metta, seṭṭha
+       e (L02h    e:       // but an aspirate is one: bhāvetha
+
+.group o
+       o        o:
+       o (L01L01  o        // sotthi, ottappa
+       o (L02h    o:       // nirodha
+
+.group k
+       k        k
+       kh       k#
+
+.group g
+       g        g
+       gh       g#
+
+.group ṅ
+       ṅ        N
+
+.group c
+       c        c
+       ch       c#
+
+.group j
+       j        J
+       jh       J#
+
+.group ñ
+       ñ        n^
+
+.group ṭ
+       ṭ        t.
+       ṭh       t.#
+
+.group ḍ
+       ḍ        d.
+       ḍh       d.#
+
+.group ṇ
+       ṇ        n.
+
+.group t
+       t        t
+       th       t#
+
+.group d
+       d        d
+       dh       d#
+
+.group n
+       n        n
+
+.group p
+       p        p
+       ph       p#
+
+.group b
+       b        b
+       bh       b#
+
+.group m
+       m        m
+
+.group y
+       y        j
+
+.group r
+       r        *       // always the tap: Hindi r turned into an English-like r at word ends and before consonants
+
+.group l
+       l        l
+
+.group ḷ
+       ḷ        l.
+       ḷh       l.H       // no aspirated ḷ in the table: ḷ + h
+
+.group v
+       v        v
+
+.group s
+       s        s
+
+.group h
+       h        H
+
+// niggahita: the nasal of the following consonant's place, ŋ elsewhere
+.group ṃ
+       ṃ        N
+       ṃ (_     NN2     // word end: a long hum (es3: a short ŋ sounded like н)
+       ṃ (c     n^
+       ṃ (j     n^
+       ṃ (ṭ     n.
+       ṃ (ḍ     n.
+       ṃ (t     n
+       ṃ (d     n
+       ṃ (p     m
+       ṃ (b     m
+
+.group ṁ
+       ṁ        N
+       ṁ (_     NN2     // word end: a long hum (es3: a short ŋ sounded like н)
+       ṁ (c     n^
+       ṁ (j     n^
+       ṁ (ṭ     n.
+       ṁ (ḍ     n.
+       ṁ (t     n
+       ṁ (d     n
+       ṁ (p     m
+       ṁ (b     m
diff --git a/espeak-ng-data/lang/inc/pi b/espeak-ng-data/lang/inc/pi
new file mode 100644
index 0000000..5be36c8
--- /dev/null
+++ b/espeak-ng-data/lang/inc/pi
@@ -0,0 +1,6 @@
+name Pali
+language pi
+stressRule 16      // penultimate if heavy, else antepenultimate
+stressOpt 5        // no automatic secondary stress
+stressLength 200 200 200 200 0 0 210 220   // vowel length comes from the spelling: stress barely lengthens
+intonation 3       // a comma does not raise the pitch (me, sā, bho read level)
diff --git a/phsource/ph_pali b/phsource/ph_pali
new file mode 100644
index 0000000..fe8ae1d
--- /dev/null
+++ b/phsource/ph_pali
@@ -0,0 +1,57 @@
+// Pali (pi): the Hindi phonemes, except that the short a is always sounded.
+// Pali spelling is phonemic: no schwa deletion (Hindi's V drops at word end and between consonants).
+
+phoneme V
+  vwl flag1 starttype #@  endtype #@
+  length 140
+  IF thisPh(isNotStressed) THEN
+    length 120
+  ENDIF
+  FMT(vowel/V_3)
+endphoneme
+
+phoneme i:        // Hindi shortens an unstressed ī; Pali keeps every long vowel long
+  vwl lng starttype #i endtype #i
+  length 230
+  IfNextVowelAppend(;)
+  FMT(vowel/i_fnt)
+endphoneme
+
+// Sounds only (CALL, not import_phoneme: an ipa line after an import silences the phoneme), the IPA stays Hindi's (Piper voices trained on Hindi know these symbols):
+phoneme J         // j: Hindi's palatal stop sounded odd, use the affricate of "judge"
+  CALL base1/dZ
+  ipa ɟ
+endphoneme
+
+phoneme v         // v: Hindi's approximant came out close to m after a nasal (samaṇena vā)
+  CALL base1/v
+  ipa ʋ
+endphoneme
+
+// TEMPORARY candidates for listening round es4 (r and v); remove after the choice
+phoneme r1
+  import_phoneme base1/r
+endphoneme
+phoneme r2
+  import_phoneme ru/r
+endphoneme
+phoneme r3
+  import_phoneme es/r
+endphoneme
+phoneme r4
+  import_phoneme hi/r
+endphoneme
+phoneme v1
+  import_phoneme hi/v
+endphoneme
+phoneme v2
+  import_phoneme ru/v
+endphoneme
+phoneme v3
+  import_phoneme it/v
+endphoneme
+
+phoneme N2        // the second half of a word-final ṁ: a long ŋ, written ŋː
+  CALL base1/N
+  ipa ː
+endphoneme
